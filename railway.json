{
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm rebuild && ./node_modules/.bin/vite build",
    "watchPatterns": ["src/**/*", "server/**/*", "public/**/*", "package.json"]
  },
  "deploy": {
    "startCommand": "npm start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
